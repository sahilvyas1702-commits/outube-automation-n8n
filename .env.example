# ============================================================================
# YOUTUBE AUTOMATION WITH N8N - ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains all environment variables required for the workflow pipeline.
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env with real secrets to version control.
#
# Phases:
#   Phase 1: 01-trend-detection.json       - Detect trending topics
#   Phase 2: 02-script-generation.json     - Generate video scripts
#   Phase 3: 03-voice-generation.json      - Synthesize voiceovers
#   Phase 3: 04-video-creation.json        - Create videos from audio
#   Phase 4: (Coming Soon)                 - Upload to YouTube
# ============================================================================

# ============================================================================
# PHASE 1: TREND DETECTION
# ============================================================================

# Reddit API Configuration
REDDIT_USER_AGENT=YourAppName/1.0 (by your_reddit_username)

# NewsAPI Configuration
# Get key from: https://newsapi.org/account
NEWSAPI_KEY=your_newsapi_key_here

# ============================================================================
# PHASE 2: SCRIPT GENERATION
# ============================================================================

# Anthropic Claude API (for script generation)
# Get key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# OpenAI API (optional fallback)
# Get key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ============================================================================
# PHASE 3A: VOICE GENERATION (Text-to-Speech)
# ============================================================================

# ElevenLabs Configuration (Primary TTS Provider)
# Get key from: https://elevenlabs.io/app/keys
ELEVENLABS_API_KEY=sk_live_your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_monolingual_v1
ELEVENLABS_STABILITY=0.75
ELEVENLABS_SIMILARITY=0.75

# Google Cloud Text-to-Speech Configuration (Fallback TTS Provider)
# Get key from: https://console.cloud.google.com/apis/credentials
# Enable the Text-to-Speech API in your Google Cloud project
GOOGLE_CLOUD_TTS_API_KEY=your_google_cloud_api_key_here
GOOGLE_CLOUD_VOICE_NAME=en-US-News-N
GOOGLE_CLOUD_SPEAKING_RATE=1.0
GOOGLE_CLOUD_PITCH=0.0

# Audio Output Configuration
AUDIO_OUTPUT_FORMAT=mp3
AUDIO_SAMPLE_RATE=44100
AUDIO_BITRATE=128k

# Script Processing
MAX_SCRIPT_LENGTH=10000
CHUNK_OVERLAP=200

# ============================================================================
# PHASE 3B: VIDEO CREATION (FFmpeg Configuration)
# ============================================================================

# FFmpeg Binary Path
# On macOS: /usr/local/bin/ffmpeg
# On Linux: /usr/bin/ffmpeg
# On Windows: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=/usr/bin/ffmpeg
FFMPEG_THREADS=4
FFMPEG_PRESET=medium
FFMPEG_CRF=23

# Long-Form Video Output Specifications (1080p, 16:9)
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_BITRATE=5000k
VIDEO_CODEC=libx264
VIDEO_FORMAT=mp4

# Audio Configuration (for video)
AUDIO_CODEC=aac
AUDIO_BITRATE=192k
AUDIO_SAMPLE_RATE=44100

# YouTube Shorts Configuration (vertical, 9:16)
SHORTS_WIDTH=1080
SHORTS_HEIGHT=1920
SHORTS_FPS=30
SHORTS_BITRATE=3000k
SHORTS_DURATION_MAX=60

# Visual Effects
BACKGROUND_SOURCE=unsplash
BACKGROUND_BLUR=5
TRANSITION_TYPE=fade
TRANSITION_DURATION=0.5
TEXT_OVERLAY_ENABLED=true
TEXT_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
TEXT_FONT_SIZE=48
TEXT_COLOR=FFFFFF

# ============================================================================
# PHASE 3: EXTERNAL APIS FOR VISUAL ASSETS
# ============================================================================

# Unsplash API (Free stock photos for video backgrounds)
# Get key from: https://unsplash.com/developers
UNSPLASH_API_KEY=your_unsplash_access_key_here

# Pexels API (Free stock videos)
# Get key from: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ============================================================================
# N8N WEBHOOK & STORAGE CONFIGURATION
# ============================================================================

# N8N Base URL (webhook trigger URLs)
N8N_WEBHOOK_URL=http://localhost:5678

# Storage Webhooks (for persisting results)
STORAGE_WEBHOOK_URL=http://localhost:5678/webhook/store-results

# Temporary & Output Directories
VIDEO_OUTPUT_DIR=/app/output/videos
SHORTS_OUTPUT_DIR=/app/output/shorts
TEMP_DIR=/tmp/n8n-video

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================

# Performance Tuning
PARALLEL_ENCODING=1
ENCODING_TIMEOUT=3600
MAX_VIDEO_LENGTH=900

# Cost Control
DAILY_USAGE_LIMIT=10000

# Logging & Debug
LOG_LEVEL=info
SAVE_MANUAL_EXECUTIONS=true

# ============================================================================
# NOTES
# ============================================================================
#
# 1. CREDENTIALS SETUP
#    - ElevenLabs: Get API key from dashboard after signup
#    - Google Cloud: Create service account and enable TTS API
#    - Unsplash: Create developer app and get access key
#    - NewsAPI: Free tier available (25 requests/day)
#
# 2. FFMPEG INSTALLATION
#    macOS:    brew install ffmpeg
#    Ubuntu:   sudo apt-get install ffmpeg
#    Windows:  Download from https://ffmpeg.org/download.html
#
# 3. PATHS
#    - Use absolute paths for FFMPEG_PATH, TEXT_FONT, VIDEO_OUTPUT_DIR, TEMP_DIR
#    - Ensure output directories exist and are writable
#    - Use forward slashes (/) even on Windows when using WSL
#
# 4. TESTING
#    - Start with small scripts (100-500 words) to test
#    - Monitor encoding logs for errors before running large batches
#    - Verify disk space: video encoding requires 2-3x output file size
#
# ============================================================================